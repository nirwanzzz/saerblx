            if root and (root.Position - position).Magnitude < radius then return true end
        end
    end
    for slot, owner in M.Plots.ReadOwners() do
        if S.AvoidedOwners[owner] then
            local plot = W.Plots:FindFirstChild(tostring(slot))
            if plot and plot:IsA("Model") then
