local function waitFor(predicate: any, seconds: number, epoch: number): any
    local deadline = os.clock() + seconds
    repeat
        if not valid(epoch) then return nil end
        local value = predicate()
        if value then return value end
        task.wait(0.1)
    until os.clock() >= deadline
    return nil
end
local function pause(seconds: number, epoch: number): boolean
    local deadline = os.clock() + seconds
    return waitFor(function() return os.clock() >= deadline end, seconds + 0.2, epoch) == true
end
local function cooldown(key: string, seconds: number): boolean
    if os.clock() < (R.Cooldowns[key] or 0) then return false end
    R.Cooldowns[key] = os.clock() + seconds
    return true
end
function R:Unload()
    if not self.Alive then return end
    stop("Unloaded")
    self.Alive = false
    for _, c in self.Connections do pcall(function() c:Disconnect() end) end
    table.clear(self.Connections)
    for _, h in self.Highlights do h:Destroy() end
    table.clear(self.Highlights)
    if self.Window and not self.WindowDestroyed then self.Window:Destroy() end
    if env[MARKER] == self then env[MARKER] = nil end
    if not self.InFlight and not self.Uncertain then marker:Destroy() end
end

local function beginRequest(name: string, kind: string, epoch: number): any
    if R.InFlight or not valid(epoch) then return nil end
    if not pause(math.max(0, R.NextRemote - os.clock()), epoch) then return nil end
    local obj = Net:FindFirstChild(name)
    assert(obj and obj:IsA(kind), "Remote contract changed: " .. name)
    R.NextRemote = os.clock() + 0.75
    R.InFlight = true
    marker:SetAttribute("InFlight", true)
    return obj
end
local function endRequest()
    R.InFlight = false
    marker:SetAttribute("InFlight", false)
    if not R.Alive and not R.Uncertain then marker:Destroy() end
end
local function request(name: string, args: any, epoch: number): any
    local obj = beginRequest(name, "RemoteFunction", epoch)
    if not obj then return nil end
    local result: any = nil
    local done = false
    task.spawn(function()
        result = table.pack(pcall(function() return obj:InvokeServer(table.unpack(args, 1, args.n)) end))
        done = true
    end)
    local deadline = os.clock() + S.ActionTimeout
    while not done and os.clock() < deadline do task.wait(0.1) end
    if not done then
        uncertain("Request timed out: " .. name)
        task.spawn(function()
            while not done do task.wait(0.5) end
            endRequest()
        end)
        return nil
    end
    endRequest()
    if not result[1] then uncertain("Network error: " .. name); return nil end
    if not valid(epoch) then uncertain("Operation completed after cancellation: " .. name); return nil end
    return table.pack(table.unpack(result, 2, result.n))
end
local function sendConfirmed(name: string, args: any, confirm: any, epoch: number): boolean
    local obj = beginRequest(name, "RemoteEvent", epoch)
    if not obj then return false end
    local ok, err = pcall(function() obj:FireServer(table.unpack(args, 1, args.n)) end)
    local landed = ok and waitFor(confirm, S.ActionTimeout, epoch)
    if not landed then uncertain("No confirmation: " .. name .. (ok and "" or (" / " .. tostring(err)))) end
    endRequest()
    return landed == true
end

