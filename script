local function candidates(): any
    local _, _, root = character()
    local result = {}
    if not root then return result end
    local speeds: any = {}
    for _, e in M.Eggs.ReadFieldEggs().Records do
        if (e.State ~= "Slot" and not (S.IncludeDropped and e.State == "Dropped"))
            or (S.Area ~= "All" and e.AreaId ~= S.Area)
            or (R.Excluded[e.Uid] or 0) > os.clock() then continue end
        if typeof(e.BoundsCFrame) ~= "CFrame" or typeof(e.BoundsSize) ~= "Vector3" then continue end
        local distance = (root.Position - e.BoundsCFrame.Position).Magnitude
        local rarity = rank(e.AssetCategory)
        if distance > S.MaxDistance or not rarity or avoided(e.BoundsCFrame.Position) then continue end
        if S.MinRarity ~= "All" and rarity < (rarityRanks[S.MinRarity] or math.huge) then continue end
        if S.SafeMode then
            if speeds[e.AreaId] == nil then
                local area = GuardAreas:FindFirstChild(e.AreaId)
                local guard = area and area:FindFirstChild("Guard")
                local guardRoot = guard and guard:FindFirstChild("HumanoidRootPart")
                local ok, required = false, nil
                if guardRoot and guardRoot:IsA("BasePart") then
                    ok, required = pcall(M.Escape.ResolveSpeedPower, area, guardRoot.Position, Separation)
                end
                speeds[e.AreaId] = ok and type(required) == "number" and required or math.huge
            end
            if (profile().SpeedPower or 0) < speeds[e.AreaId] then continue end
        end
        local ok, value = pcall(M.Records.SellPrice, e)
        table.insert(result, {Egg = e, Distance = distance, Rarity = rarity, Value = ok and tonumber(value) or 0})
    end
    table.sort(result, function(a, b)
        if S.Priority == "Rarity" and a.Rarity ~= b.Rarity then return a.Rarity > b.Rarity end
        if S.Priority == "Value" and a.Value ~= b.Value then return a.Value > b.Value end
        return a.Distance < b.Distance
    end)
    return result
end

local function walk(destination: Vector3, epoch: number): boolean
    local deadline = os.clock() + S.TravelTimeout
    for _ = 0, S.RouteRetries do
        if not valid(epoch) or os.clock() >= deadline then break end
        local _, h, root = character()
        if (root.Position - destination).Magnitude <= 5 then return true end
        local path = Pathfinding:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 5})
        local ok = pcall(function() path:ComputeAsync(root.Position, destination) end)
        if not valid(epoch) then path:Destroy(); break end
        if not ok or path.Status ~= Enum.PathStatus.Success then path:Destroy(); if not pause(0.5, epoch) then break end; continue end
        local reached = true
        for _, point in path:GetWaypoints() do
            if not valid(epoch) or os.clock() >= deadline then reached = false; break end
            R.Moving = true
            if point.Action == Enum.PathWaypointAction.Jump then h.Jump = true end
            h:MoveTo(point.Position)
            local lastPosition = root.Position
            local lastProgress = os.clock()
            local pointDeadline = math.min(deadline, os.clock() + 8)
            while (root.Position - point.Position).Magnitude > 4 do
                if not valid(epoch) or os.clock() >= pointDeadline or os.clock() - lastProgress > 2.5 then reached = false; break end
                if (root.Position - lastPosition).Magnitude >= 1 then lastPosition = root.Position; lastProgress = os.clock() end
                task.wait(0.1)
            end
            if not reached then break end
        end
        path:Destroy()
        cancelMovement()
        if reached and (root.Position - destination).Magnitude <= 6 then return true end
    end
    cancelMovement()
    return false
end
local function returnBase(epoch: number): boolean
    local plot = M.Plots.ResolvePlot()
    if not plot then stop("Your plot is unavailable"); return false end
    state("RETURN_TO_BASE", "Returning to your plot")
    return walk(plot.RespawnPointCFrame.Position, epoch)
end
local function eggDistance(e: any, position: Vector3): number
    local p = e.BoundsCFrame:PointToObjectSpace(position)
    local half = e.BoundsSize / 2
    local closest = Vector3.new(math.clamp(p.X, -half.X, half.X), math.clamp(p.Y, -half.Y, half.Y), math.clamp(p.Z, -half.Z, half.Z))
    return (p - closest).Magnitude
end
local function farm(epoch: number)
    if not capacity() then return end
    if carrying() then stop("You are already carrying an egg. Deliver it before starting another cycle"); return end
    state("SELECT_TARGET", "Finding an egg")
    local target = candidates()[1]
    if not target then state("WAIT", "No targets match these filters"); return end
    local egg = target.Egg
    local _, _, root = character()
    local away = Vector3.new(root.Position.X - egg.BoundsCFrame.X, 0, root.Position.Z - egg.BoundsCFrame.Z)
    if away.Magnitude < 0.01 then away = Vector3.xAxis end
    local radius = math.max(egg.BoundsSize.X, egg.BoundsSize.Z) / 2 + 2.5
    local approach = egg.BoundsCFrame.Position + away.Unit * radius
    approach = Vector3.new(approach.X, egg.BottomCFrame.Y + 2, approach.Z)
    state("TRAVEL", egg.AreaId .. " / " .. egg.AssetCategory)
    if not walk(approach, epoch) then R.Excluded[egg.Uid] = os.clock() + 30; return end
    state("VALIDATE_TARGET", egg.AssetCategory)
    if not pause(W:GetAttribute("FastEggPickupTime") and 0.3 or 1.25, epoch) then return end
    local current = M.Eggs.ReadFieldEgg(egg.Uid)
    local _, _, nowRoot = character()
    if not current or current.Version ~= egg.Version or current.State ~= egg.State
        or not nowRoot or eggDistance(current, nowRoot.Position) > 8 or avoided(nowRoot.Position)
        or not capacity() or carrying() then R.Excluded[egg.Uid] = os.clock() + 15; return end
    local before = {}
    for uid in profile().EggInventory do before[uid] = true end
    local payload: any = {Uid = egg.Uid}
    if egg.Uid:sub(1, 13) == "FirstAreaEgg_" then payload.FirstAreaSlotKey = egg.AreaId .. ":" .. egg.NestId end
    state("COLLECT", egg.AssetCategory)
    local result = request("RF/EggWorld/AskFieldEggCarry", table.pack(payload), epoch)
    if not result then return end
    if result[1] ~= true then R.Excluded[egg.Uid] = os.clock() + 30; log(tostring(result[2]), true); return end
    if not waitFor(function() return carrying() == egg.Uid end, S.ActionTimeout, epoch) then
        uncertain("Pickup accepted without a carrying-state confirmation"); return
    end
    state("DELIVER", "Crossing into the delivery area")
    local _, _, carryRoot = character()
    local depth = Separation.CFrame.LookVector:Dot(carryRoot.Position - Separation.Position)
    local exitPoint = carryRoot.Position - Separation.CFrame.LookVector * (depth + 12)
    if not walk(exitPoint, epoch) then uncertain("Could not complete the route while carrying an egg"); return end
    local delivered = waitFor(function()
        local p = profile()
        if not p or carrying() then return nil end
        local found = {}
        for uid, item in p.EggInventory do
            if not before[uid] and item.AssetCategory == egg.AssetCategory then table.insert(found, uid) end
        end
        return #found == 1 and found[1] or nil
    end, S.ActionTimeout, epoch)
    if not delivered then uncertain("Delivery did not confirm exactly one new matching inventory egg"); return end
    R.OwnedThisRun[delivered] = true
    R.Collected += 1
    log("Delivered: " .. egg.AssetCategory, true)
    if not returnBase(epoch) and valid(epoch) then stop("Could not return to your base") end
end

local function freePlacement(plot: any, item: any): CFrame?
    local area = plot.PetArea
    local spacing = math.max(6, (tonumber(item.AssetScale) or 1) * 4)
    local owned = M.Eggs.ReadOwnerEggs(Player.UserId)
    for x = -area.Size.X / 2 + spacing, area.Size.X / 2 - spacing, spacing do
        for z = -area.Size.Z / 2 + spacing, area.Size.Z / 2 - spacing, spacing do
            local point = area.CFrame:PointToWorldSpace(Vector3.new(x, area.Size.Y / 2, z))
            local available = true
            for _, other in owned do
                if other.Placement then
                    local otherPoint = (plot.CenterPoint.CFrame * other.Placement.LocalCFrame).Position
                    local distance = Vector3.new(point.X - otherPoint.X, 0, point.Z - otherPoint.Z).Magnitude
                    if distance < math.max(spacing, (tonumber(other.AssetScale) or 1) * 4) then available = false; break end
                end
            end
            if available then return plot.CenterPoint.CFrame:ToObjectSpace(CFrame.new(point)) end
        end
    end
    return nil
end
local function placeOne(epoch: number): boolean
    local p = profile()
    if not p or carrying() then return false end
    for uid, item in p.EggInventory do
        if item.Placement or not canProcess(uid) or not cooldown("place:" .. uid, 30) then continue end
        if not returnBase(epoch) then return false end
        local plot = M.Plots.ResolvePlot()
        local point = plot and freePlacement(plot, item)
        if not point then state("WAIT", "No placement space meets the spacing checks"); return false end
        state("EQUIP_EGG", uid)
        local equip = request("RF/EggWorld/AskWearTool", table.pack(uid), epoch)
        if not equip or equip[1] ~= true then return true end
        local toolReady = waitFor(function()
            local c = character()
            if not c then return false end
            for _, tool in c:GetChildren() do
                if tool:IsA("Tool") and M.EggTools.IsEggTool(tool) and M.EggTools.GetToolUid(tool) == uid then return true end
            end
            return false
        end, S.ActionTimeout, epoch)
        if not toolReady then uncertain("Egg tool was not confirmed: " .. uid); return true end
        local latest = profile().EggInventory[uid]
        if not latest or latest.Placement or not canProcess(uid) then return true end
        state("PLACE", uid)
        local result = request("RF/EggWorld/AskPlaceEgg", table.pack({Uid = uid, LocalCFrame = point}), epoch)
        if not result or result[1] ~= true then return true end
        if not waitFor(function()
            local current = profile() and profile().EggInventory[uid]
            return current ~= nil and current.Placement ~= nil
        end, S.ActionTimeout, epoch) then uncertain("Placement was not confirmed: " .. uid); return true end
        R.Placed += 1
        return true
    end
    return false
end
local function hatchOne(epoch: number): boolean
    local p = profile()
    if not p or carrying() or count(p.Inventory) >= 250 - S.PetReserve then return false end
    if S.SafeMode and next(p.AutoSellRarities or {}) then stop("The game's built-in Auto Sell is enabled"); return false end
    for uid, item in p.EggInventory do
        if not item.Placement or not canProcess(uid) or protected(uid, item)
            or not M.Eggs.IsReadyToHatch(uid) or not cooldown("hatch:" .. uid, 60) then continue end
        if not returnBase(epoch) then return false end
        local current = profile().EggInventory[uid]
        local renders = W:FindFirstChild("PlacedEggRenders")
        local model = renders and renders:FindFirstChild(tostring(Player.UserId) .. "_" .. uid)
        if not current or protected(uid, current) or not M.Eggs.IsReadyToHatch(uid) or not model then return false end
        state("HATCH", uid)
        local begin = request("RF/EggWorld/AskHatch", table.pack(uid), epoch)
        if not begin or begin[1] ~= true then return true end
        R.HatchUid = uid
        marker:SetAttribute("HatchUid", uid)
        if begin[3] ~= nil and begin[3] ~= "" then
            uncertain("Special hatch result: " .. tostring(begin[3]) .. ". Complete this egg manually in the game.")
            return true
        end
        local record = M.Eggs.ReadOwnedEgg(Player.UserId, uid)
        if not record then uncertain("Egg record missing after starting the hatch"); return true end
        local animation: any = {Done = false}
        task.spawn(function()
            animation.Ok, animation.Sound = pcall(M.HatchAnimation.Play, Player.UserId, uid, record, model, false)
            animation.Done = true
        end)
        if not waitFor(function() return animation.Done end, 45, epoch) or not animation.Ok then
            uncertain("Hatch animation did not complete; review egg " .. uid); return true
        end
        local finish = request("RF/EggWorld/AskFinishHatch", table.pack(uid), epoch)
        if not finish or finish[1] ~= true or type(finish[3]) ~= "string" then
            uncertain("Hatch started without confirmed completion: " .. uid); return true
        end
        local granted = finish[3]
        if not waitFor(function()
            local latest = profile()
            return latest and latest.EggInventory[uid] == nil and latest.Inventory[granted] ~= nil
        end, S.ActionTimeout, epoch) then uncertain("The granted pet did not appear"); return true end
        if animation.Sound then M.HatchAnimation.FadeSoundWhenGrantedToolUnequips(animation.Sound, granted) end
        R.HatchUid = nil
        marker:SetAttribute("HatchUid", nil)
        R.Hatched += 1
        R.OwnedThisRun[uid] = nil
        return true
    end
    return false
end
local function sellOne(epoch: number): boolean
    local p = profile()
    if not p or carrying() then return false end
    local eggs = S.SellKind == "Eggs"
    local field = eggs and "EggInventory" or "Inventory"
    local equipped = {}
    for _, uid in p.EquippedAssets do equipped[uid] = true end
    for uid, item in p[field] do
        if protected(uid, item) or item.Placement or equipped[uid] or (eggs and not canProcess(uid)) then continue end
        if not cooldown("sell:" .. uid, 60) then continue end
        state("SELL", uid)
        local payload = {Assets = {}, Eggs = {}}
        if eggs then table.insert(payload.Eggs, uid) else table.insert(payload.Assets, uid) end
        if sendConfirmed("RE/PetSatchel/SellSelection", table.pack(payload), function()
            local latest = profile()
            return latest ~= nil and latest[field][uid] == nil
        end, epoch) then R.Sold += 1 end
        return true
    end
    return false
end
local function upgrade(kind: string, epoch: number): boolean
    local p = profile()
    if not p or carrying() or S.Budget <= R.Spent then return false end
    local base = kind == "Base"
    local field = base and "BaseUpgradeLevel" or "TreadmillUpgradeLevel"
    local level = p[field]
    if type(level) ~= "number" then return false end
    local config
    if base then config = M.Bases.BASES[level + 1] else config = M.Treadmills.GetByUpgradeLevel(level + 1) end
    if not config then return false end
    local cost = base and config.Cost or config.Price
    if type(cost) ~= "number" or cost <= 0 or cost ~= cost or cost == math.huge
        or cost > S.MaxPurchase or cost > S.Budget - R.Spent or p.Money - cost < S.MinimumReserve then return false end
    if not cooldown("upgrade:" .. kind, 15) then return false end
    state("UPGRADE", kind .. " / " .. tostring(cost))
    R.Spent += cost
    if base then
        sendConfirmed("RE/Homestead/AskBaseTierRaise", table.pack(), function()
            return profile() ~= nil and profile()[field] > level
        end, epoch)
    else
        local result = request("RF/Treadmill/AskTierRaise", table.pack(config._id), epoch)
        if result and result[1] ~= true then
            R.Spent -= cost
            log(tostring(result[2]), true)
        elseif result and not waitFor(function() return profile() ~= nil and profile()[field] > level end, S.ActionTimeout, epoch) then
            uncertain("Treadmill upgrade was not confirmed")
        end
    end
    return true
end
local function maintain(epoch: number): boolean
    if carrying() then return false end
    if S.AutoHatch and hatchOne(epoch) then return true end
    if not valid(epoch) then return true end
    if S.AutoPlace and placeOne(epoch) then return true end
    if not valid(epoch) then return true end
    if S.AutoEquipBest and cooldown("best", 10) then
        state("EQUIP_BEST", "Equipping your best pets")
        request("RF/Haul/WearBest", table.pack(), epoch)
        return true
    end
    local p = profile()
    if S.AutoIndex and cooldown("index", 15) then
        for category, unlocked in p.Index do
            if unlocked and not p.IndexClaimedCategories[category] then
                state("CLAIM_INDEX", category)
                request("RF/Codex/AskRedeemAll", table.pack(), epoch)
                return true
            end
        end
    end
    if S.AutoOffline and (p.PendingOfflineMoney or 0) >= 5 and cooldown("offline", 30) then
        state("CLAIM_OFFLINE", "Claiming pending offline earnings")
        request("RF/AwayEarnings/AskCollect", table.pack({Kind = "Claim"}), epoch)
        return true
    end
    if S.AutoSell and sellOne(epoch) then return true end
    if not valid(epoch) then return true end
    if S.AutoBase and upgrade("Base", epoch) then return true end
    if not valid(epoch) then return true end
    if S.AutoTreadmill and upgrade("Treadmill", epoch) then return true end
    return false
end

local function updateESP()
    local _, _, root = character()
    local wanted: any = {}
    local amount = 0
    local function add(model: any, color: Color3)
        if not root or not model or not model:IsA("Model") or amount >= 80 then return end
        if (model:GetPivot().Position - root.Position).Magnitude > S.ESPDistance then return end
        wanted[model] = color
        amount += 1
    end
    if S.EggESP then
        local slots = W:FindFirstChild("AreaEggSlotsClient")
        local eggs = W:FindFirstChild("Eggs")
        for _, e in M.Eggs.ReadFieldEggs().Records do
            local model = (slots and slots:FindFirstChild(e.Uid)) or (eggs and eggs:FindFirstChild(e.Uid))
            local cfg = M.Assets.Directory[e.AssetCategory]
            add(model, cfg and cfg.Rarity.Color or Color3.fromRGB(255, 209, 92))
        end
    end
    if S.PlayerESP then
        for _, other in Players:GetPlayers() do if other ~= Player then add(other.Character, Color3.fromRGB(95, 192, 255)) end end
    end
    if S.BaseESP then
        for slot, owner in M.Plots.ReadOwners() do
            add(W.Plots:FindFirstChild(tostring(slot)), owner == Player.UserId and Color3.fromRGB(90, 230, 145) or Color3.fromRGB(186, 130, 255))
        end
    end
    for model, highlight in R.Highlights do
        if not wanted[model] then highlight:Destroy(); R.Highlights[model] = nil end
    end
    for model, color in wanted do
        local highlight = R.Highlights[model]
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "BRP_EggESP"
            highlight.Adornee = model
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.FillTransparency = 0.8
            highlight.OutlineTransparency = 0
            highlight.Parent = marker
            R.Highlights[model] = highlight
        end
        highlight.FillColor, highlight.OutlineColor = color, color
    end
end
function R:GetStatus()
    local p = profile()
    local flags = {}
    for _, key in AUTO do flags[key] = S[key] end
    return {
        Alive = self.Alive, State = self.State, Reason = self.Reason, LastError = self.LastError,
        Busy = self.WorkerBusy, InFlight = self.InFlight, Uncertain = self.Uncertain,
        PlaceVersion = game.PlaceVersion, PlaceId = game.PlaceId, UniverseId = game.GameId,
        Eggs = p and count(p.EggInventory) or 0, Pets = p and count(p.Inventory) or 0,
        Collected = self.Collected, Placed = self.Placed, Hatched = self.Hatched, Sold = self.Sold,
        Spent = self.Spent, Budget = S.Budget, Flags = flags, Carrying = carrying(),
        Connections = #self.Connections, Highlights = count(self.Highlights),
    }
end
local function acknowledge(): boolean
    if R.InFlight or R.WorkerBusy or carrying() then log("Wait for the pending operation and deliver any egg you are carrying.", true); return false end
    if R.HatchUid and profile() and profile().EggInventory[R.HatchUid] then
        log("Manually complete egg " .. R.HatchUid .. " before clearing the lock.", true)
        return false
    end
    R.Uncertain, R.HatchUid, R.LastError = false, nil, ""
    marker:SetAttribute("Uncertain", false)
    marker:SetAttribute("HatchUid", nil)
    state("IDLE", "Reviewed. Automations are disabled")
    if not R.Alive then marker:Destroy() end
    return true
end
local command = Instance.new("BindableFunction")
command.Name = "Command"
command.OnInvoke = function(action: string)
    if action == "status" then return R:GetStatus() end
    if action == "diagnose" then
        local list = candidates()
        local first = list[1]
        return {Status = R:GetStatus(), Candidates = #list,
            FirstTarget = first and {Uid = first.Egg.Uid, Area = first.Egg.AreaId, Distance = first.Distance},
            HasPlot = M.Plots.ResolvePlot() ~= nil, Areas = areaNames, Rarities = rarityNames}
    end
    if action == "stop" then stop("Stopped manually"); return true end
    if action == "acknowledge" then return acknowledge() end
    if action == "unload" then R:Unload(); return true end
    return nil
end
command.Parent = marker

